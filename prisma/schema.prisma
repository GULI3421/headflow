generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum LeadType {
  callback
  calculator
}

enum OrderStatus {
  NEW
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum CalculatorEstimateStatus {
  NEW
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum TelegramDeliveryStatus {
  PENDING
  SENT
  FAILED
}

type OrderItem {
  productId         String?
  inventoryDeducted Int?
  name              String
  variant           String?
  quantity          Int
  unitPrice         Float
  lineTotal         Float
}

model Category {
  id      String @id @default(auto()) @map("_id") @db.ObjectId
  name_ru String
  name_ky String
  name_en String
  slug    String @unique

  @@map("categories")
}

model Product {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  title_ru       String
  title_ky       String?
  title_en       String?
  description_ru String?
  description_ky String?
  description_en String?
  price          Float
  old_price      Float?
  stock          Int      @default(0)
  oldPrice       Float?
  stockQuantity  Int      @default(0)
  powerVariants  Json?
  image_id       String[] @default([])
  imageUrl       String?
  certificateUrl String?
  certificateFileName String?
  passportUrl    String?
  passportFileName String?
  category       String
  subcategory    String?
  power_options  String[] @default([])
  description    String?
  specs          Json?
  brand          String?
  badgeKey       String?
  energyClass    String?
  pressure       String?
  power          String?

  @@index([category])
  @@map("products")
}

model PriceList {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  fileUrl     String
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  @@index([updatedAt])
  @@map("price_lists")
}

model Lead {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  phone     String
  message   String?
  type      LeadType @default(callback)
  createdAt DateTime @default(now())

  @@index([type])
  @@index([createdAt])
  @@map("leads")
}

model Order {
  id              String      @id @default(auto()) @map("_id") @db.ObjectId
  orderNumber     String      @unique
  createdAt       DateTime    @default(now())
  customerName    String
  customerPhone   String
  customerComment String?
  items           OrderItem[]
  totalAmount     Float
  status          OrderStatus @default(NEW)

  @@index([createdAt])
  @@index([status, createdAt])
  @@map("orders")
}

model CalculatorEstimate {
  id             String                   @id @default(auto()) @map("_id") @db.ObjectId
  name           String
  phone          String
  totalAmount    Float
  parameters     Json
  breakdown      Json
  status         CalculatorEstimateStatus @default(NEW)
  telegramStatus TelegramDeliveryStatus   @default(PENDING)
  telegramError  String?
  telegramSentAt DateTime?
  createdAt      DateTime                 @default(now())

  @@index([createdAt])
  @@index([status, createdAt])
  @@index([telegramStatus, createdAt])
  @@map("calculator_estimates")
}

model AdminUser {
  id           String         @id @default(auto()) @map("_id") @db.ObjectId
  email        String         @unique
  passwordHash String
  createdAt    DateTime       @default(now())
  sessions     AdminSession[]

  @@map("admin_users")
}

model AdminSession {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  tokenHash String    @unique
  userId    String    @db.ObjectId
  user      AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@map("admin_sessions")
}
